{
  "name": "uma-parent-deck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "fetch": "node scripts/fetch-gametora.mjs && node scripts/fetch-event-names.mjs && node scripts/fetch-gametora.mjs --no-images",
    "fit": "python3 analysis/fit_stat_model.py",
    "test": "node --test tests/*.test.ts",
    "smoke": "node tests/smoke.mjs",
    "test:e2e": "node tests/smoke.mjs && node tests/regressions.mjs && node --test tests/scroll-anchor.mjs",
    "inspect": "node tests/inspect.ts"
  },
  "dependencies": {
    "lit-html": "^3.3.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "playwright": "^1.62.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
